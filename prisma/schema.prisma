generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum MemberCategory {
  STUDENT
  ALUMNI
  LECTURER
}

enum ConstitutionalMembershipCategory {
  ORDINARY
  ASSOCIATE
  ALUMNI
  HONORARY
}

enum GoodStandingStatus {
  GOOD_STANDING
  NOT_IN_GOOD_STANDING
  EXTENSION_GRANTED
}

enum FinancialComplianceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  EXTENSION_GRANTED
  OVERDUE
}

enum DisciplinaryStatus {
  CLEAR
  UNDER_REVIEW
  SANCTIONED
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberSource {
  REGISTRATION
  MANUAL_ENTRY
  MIGRATION_IMPORT
  MIGRATION_MANUAL
}

enum MemberActivationStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  EXPIRED
}

enum MembershipPeriodStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MigrationBatchStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum MigrationRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  ROLE_CHANGE
  PERMISSION_CHANGE
  OWNERSHIP_CHANGE
  OTHER
}

enum NotificationType {
  MIGRATION_WELCOME
  MEMBER_WELCOME
  ACCOUNT_ACTIVATED
  MEMBERSHIP_RENEWAL
  PAYMENT_CONFIRMATION
  PASSWORD_RESET
  GENERAL_NOTICE
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum PositionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TermStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PositionAssignmentStatus {
  PENDING
  ACTIVE
  ENDED
  REVOKED
}

enum FeeType {
  ADMISSION
  ANNUAL_MEMBERSHIP
  EVENT
  ACTIVITY
  OTHER
}

enum FeeScheduleStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ChargeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
  MANUAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReceiptStatus {
  ISSUED
  VOIDED
}

enum PaymentProviderType {
  MPESA
  BANK
  OTHER
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  members               Member[]
  roles                 Role[]
  membershipPeriods     MembershipPeriod[]
  auditLogs             AuditLog[]
  migrationBatches      MigrationBatch[]
  notifications         Notification[]
  positions             Position[]
  terms                 Term[]
  positionAssignments   PositionAssignment[]
  feeDefinitions        FeeDefinition[]
  feeSchedules          FeeSchedule[]
  memberCharges         MemberCharge[]
  payments              Payment[]
  paymentProviders      PaymentProvider[]
  paymentConfigurations PaymentConfiguration[]
  receipts              Receipt[]
  financialPeriods      FinancialPeriod[]

  @@index([name])
}

model User {
  id             String @id @default(uuid())
  organizationId String

  firstName String?
  lastName  String?
  phone     String?

  email         String     @unique
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  isSystemOwner Boolean    @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  member        Member?
  userRoles     UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  @@index([organizationId])
  @@index([status])
  @@index([firstName])
  @@index([lastName])
}

model Member {
  id             String  @id @default(uuid())
  organizationId String
  userId         String? @unique

  category MemberCategory @default(STUDENT)

  // Constitutional membership category.
  // category remains the portal/profile classification.
  constitutionalCategory ConstitutionalMembershipCategory @default(ORDINARY)

  // Compliance dimensions are intentionally separate.
  goodStandingStatus GoodStandingStatus        @default(GOOD_STANDING)
  financialStatus    FinancialComplianceStatus @default(UNPAID)
  disciplinaryStatus DisciplinaryStatus        @default(CLEAR)
  registrationNumber String?                   @unique
  admissionNumber    String?
  memberNumber       String                    @unique

  yearOfStudy    Int?
  graduationYear Int?
  nationalId     String? @unique
  staffNumber    String? @unique
  position       String?

  programme  String?
  faculty    String?
  department String?

  email   String?
  phone   String?
  address String?
  county  String?

  status MemberStatus @default(PENDING)

  source           MemberSource           @default(REGISTRATION)
  activationStatus MemberActivationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  membershipPeriods   MembershipPeriod[]
  activation          MemberActivation?
  notifications       Notification[]
  positionAssignments PositionAssignment[]
  memberCharges       MemberCharge[]
  payments            Payment[]
  receipts            Receipt[]

  @@index([organizationId])
  @@index([status])
  @@index([source])
  @@index([activationStatus])
  @@index([constitutionalCategory])
  @@index([goodStandingStatus])
  @@index([financialStatus])
  @@index([disciplinaryStatus])
}

model MemberActivation {
  id       String @id @default(uuid())
  memberId String @unique

  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MemberNumberSequence {
  id            String         @id @default(uuid())
  category      MemberCategory @unique
  currentNumber Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MembershipPeriod {
  id             String                 @id @default(uuid())
  memberId       String
  organizationId String
  membershipYear String
  startsAt       DateTime
  endsAt         DateTime
  status         MembershipPeriodStatus @default(PENDING)
  activatedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberCharges MemberCharge[]

  @@unique([memberId, membershipYear])
  @@index([organizationId])
  @@index([status])
  @@index([startsAt, endsAt])
}

model MigrationBatch {
  id             String @id @default(uuid())
  organizationId String

  fileName String
  source   MemberSource
  status   MigrationBatchStatus @default(UPLOADED)

  totalRows    Int @default(0)
  validRows    Int @default(0)
  invalidRows  Int @default(0)
  importedRows Int @default(0)
  failedRows   Int @default(0)
  skippedRows  Int @default(0)

  createdBy   String
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows         MigrationBatchRow[]

  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

model MigrationBatchRow {
  id               String @id @default(uuid())
  migrationBatchId String

  rowNumber Int
  status    MigrationRowStatus @default(PENDING)

  category MemberCategory?

  firstName String?
  lastName  String?

  registrationNumber String?
  nationalId         String?
  staffNumber        String?

  yearOfStudy    Int?
  graduationYear Int?
  programme      String?
  faculty        String?
  department     String?
  position       String?

  email   String?
  phone   String?
  address String?
  county  String?

  memberId     String?
  memberNumber String?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  migrationBatch MigrationBatch @relation(fields: [migrationBatchId], references: [id], onDelete: Cascade)

  @@unique([migrationBatchId, rowNumber])
  @@index([migrationBatchId])
  @@index([status])
  @@index([memberId])
}

model Role {
  id             String @id @default(uuid())
  organizationId String

  name         String
  code         String
  description  String?
  isSystemRole Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id])
  userRoles               UserRole[]
  rolePermissions         RolePermission[]
  positionAssignmentRoles PositionAssignmentRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  assignedAt DateTime @default(now())
  assignedBy String?

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([revokedAt])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id             String  @id @default(uuid())
  organizationId String
  memberId       String?
  userId         String?

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  recipient   String
  subject     String?
  templateKey String?

  providerMessageId String?

  sentAt   DateTime?
  failedAt DateTime?

  errorMessage String?
  attempts     Int     @default(0)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([memberId])
  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model Position {
  id             String @id @default(uuid())
  organizationId String

  name        String
  code        String
  description String?
  status      PositionStatus @default(ACTIVE)
  isExecutive Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  PositionAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([isExecutive])
}

model Term {
  id             String @id @default(uuid())
  organizationId String

  name     String
  code     String
  startsAt DateTime
  endsAt   DateTime
  status   TermStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  PositionAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([startsAt, endsAt])
}

model PositionAssignment {
  id             String @id @default(uuid())
  organizationId String
  memberId       String
  positionId     String
  termId         String

  status PositionAssignmentStatus @default(PENDING)

  startsAt DateTime
  endsAt   DateTime

  assignedAt DateTime  @default(now())
  assignedBy String?
  endedAt    DateTime?
  revokedAt  DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position     Position                 @relation(fields: [positionId], references: [id], onDelete: Cascade)
  term         Term                     @relation(fields: [termId], references: [id], onDelete: Cascade)
  roles        PositionAssignmentRole[]

  @@unique([memberId, positionId, termId])
  @@index([organizationId])
  @@index([memberId])
  @@index([positionId])
  @@index([termId])
  @@index([status])
  @@index([startsAt, endsAt])
}

model PositionAssignmentRole {
  id                   String @id @default(uuid())
  positionAssignmentId String
  roleId               String

  assignedAt DateTime @default(now())
  assignedBy String?

  positionAssignment PositionAssignment @relation(fields: [positionAssignmentId], references: [id], onDelete: Cascade)
  role               Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([positionAssignmentId, roleId])
  @@index([positionAssignmentId])
  @@index([roleId])
}

model FeeDefinition {
  id             String @id @default(uuid())
  organizationId String

  code        String
  name        String
  description String?
  type        FeeType
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedules    FeeSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

model FeeSchedule {
  id              String @id @default(uuid())
  organizationId  String
  feeDefinitionId String

  name     String
  amount   Decimal           @db.Decimal(12, 2)
  currency String            @default("KES")
  status   FeeScheduleStatus @default(DRAFT)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  constitutionalCategory ConstitutionalMembershipCategory?
  memberCategory         MemberCategory?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feeDefinition FeeDefinition  @relation(fields: [feeDefinitionId], references: [id], onDelete: Cascade)
  memberCharges MemberCharge[]

  @@index([organizationId])
  @@index([feeDefinitionId])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
  @@index([constitutionalCategory])
  @@index([memberCategory])
}

model MemberCharge {
  id                 String  @id @default(uuid())
  organizationId     String
  memberId           String
  feeScheduleId      String
  membershipPeriodId String?

  description String?
  amountDue   Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @db.Decimal(12, 2)

  currency String       @default("KES")
  status   ChargeStatus @default(UNPAID)

  dueDate      DateTime?
  waivedAt     DateTime?
  waivedBy     String?
  waiverReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member           Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  feeSchedule      FeeSchedule         @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  membershipPeriod MembershipPeriod?   @relation(fields: [membershipPeriodId], references: [id], onDelete: SetNull)
  allocations      PaymentAllocation[]

  @@index([organizationId])
  @@index([memberId])
  @@index([feeScheduleId])
  @@index([membershipPeriodId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id             String @id @default(uuid())
  organizationId String
  memberId       String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("KES")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  reference         String?
  externalReference String?
  description       String?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  allocations      PaymentAllocation[]
  receipt          Receipt?
  mpesaTransaction MpesaTransaction?

  @@index([organizationId])
  @@index([memberId])
  @@index([method])
  @@index([status])
  @@index([reference])
  @@index([externalReference])
  @@index([paidAt])
}

model PaymentAllocation {
  id        String @id @default(uuid())
  paymentId String
  chargeId  String

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  MemberCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeId])
  @@index([paymentId])
  @@index([chargeId])
}

model PaymentProvider {
  id             String @id @default(uuid())
  organizationId String

  name      String
  code      String
  type      PaymentProviderType
  isActive  Boolean             @default(true)
  isDefault Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configurations PaymentConfiguration[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

model PaymentConfiguration {
  id             String @id @default(uuid())
  organizationId String
  providerId     String

  environment String @default("sandbox")
  currency    String @default("KES")

  shortcode     String?
  tillNumber    String?
  paybillNumber String?

  enabled Boolean @default(true)

  minimumAmount Decimal? @db.Decimal(12, 2)
  maximumAmount Decimal? @db.Decimal(12, 2)

  callbackUrl String?

  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider     PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerId])
  @@index([organizationId])
  @@index([providerId])
  @@index([enabled])
}

model MpesaTransaction {
  id        String @id @default(uuid())
  paymentId String @unique

  merchantRequestId  String?
  checkoutRequestId  String?
  mpesaReceiptNumber String?

  phoneNumber       String?
  resultCode        Int?
  resultDescription String?

  transactionDate DateTime?

  callbackPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([merchantRequestId])
  @@index([checkoutRequestId])
  @@index([mpesaReceiptNumber])
  @@index([phoneNumber])
}

model Receipt {
  id             String @id @default(uuid())
  organizationId String
  memberId       String
  paymentId      String @unique

  receiptNumber String
  status        ReceiptStatus @default(ISSUED)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("KES")

  issuedAt   DateTime  @default(now())
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([issuedAt])
}

model FinancialPeriod {
  id             String @id @default(uuid())
  organizationId String

  name     String
  code     String
  startsAt DateTime
  endsAt   DateTime
  status   FinancialPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([startsAt, endsAt])
}
