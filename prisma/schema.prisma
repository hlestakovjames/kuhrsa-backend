generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum MemberCategory {
  STUDENT
  ALUMNI
  LECTURER
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum MemberSource {
  REGISTRATION
  MANUAL_ENTRY
  MIGRATION_IMPORT
  MIGRATION_MANUAL
}

enum MemberActivationStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
  EXPIRED
}

enum MembershipPeriodStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MigrationBatchStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum MigrationRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  FAILED
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  ROLE_CHANGE
  PERMISSION_CHANGE
  OWNERSHIP_CHANGE
  OTHER
}

enum NotificationType {
  MIGRATION_WELCOME
  MEMBER_WELCOME
  ACCOUNT_ACTIVATED
  MEMBERSHIP_RENEWAL
  PAYMENT_CONFIRMATION
  PASSWORD_RESET
  GENERAL_NOTICE
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  members           Member[]
  roles             Role[]
  membershipPeriods MembershipPeriod[]
  auditLogs         AuditLog[]
  migrationBatches  MigrationBatch[]
  notifications     Notification[]

  @@index([name])
}

model User {
  id             String @id @default(uuid())
  organizationId String

  firstName String?
  lastName  String?
  phone     String?

  email         String     @unique
  passwordHash  String
  status        UserStatus @default(ACTIVE)
  isSystemOwner Boolean    @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  member        Member?
  userRoles     UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  @@index([organizationId])
  @@index([status])
  @@index([firstName])
  @@index([lastName])
}

model Member {
  id             String  @id @default(uuid())
  organizationId String
  userId         String? @unique

  category           MemberCategory @default(STUDENT)
  registrationNumber String?        @unique
  admissionNumber    String?
  memberNumber       String         @unique

  yearOfStudy    Int?
  graduationYear Int?
  nationalId     String? @unique
  staffNumber    String? @unique
  position       String?

  programme  String?
  faculty    String?
  department String?

  email   String?
  phone   String?
  address String?
  county  String?

  status MemberStatus @default(PENDING)

  source           MemberSource           @default(REGISTRATION)
  activationStatus MemberActivationStatus @default(NOT_REQUIRED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  membershipPeriods MembershipPeriod[]
  activation        MemberActivation?
  notifications     Notification[]

  @@index([organizationId])
  @@index([status])
  @@index([source])
  @@index([activationStatus])
}

model MemberActivation {
  id       String @id @default(uuid())
  memberId String @unique

  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MemberNumberSequence {
  id            String         @id @default(uuid())
  category      MemberCategory @unique
  currentNumber Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MembershipPeriod {
  id             String                 @id @default(uuid())
  memberId       String
  organizationId String
  membershipYear String
  startsAt       DateTime
  endsAt         DateTime
  status         MembershipPeriodStatus @default(PENDING)
  activatedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([memberId, membershipYear])
  @@index([organizationId])
  @@index([status])
  @@index([startsAt, endsAt])
}

model MigrationBatch {
  id             String @id @default(uuid())
  organizationId String

  fileName String
  source   MemberSource
  status   MigrationBatchStatus @default(UPLOADED)

  totalRows    Int @default(0)
  validRows    Int @default(0)
  invalidRows  Int @default(0)
  importedRows Int @default(0)
  failedRows   Int @default(0)
  skippedRows  Int @default(0)

  createdBy   String
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows         MigrationBatchRow[]

  @@index([organizationId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

model MigrationBatchRow {
  id               String @id @default(uuid())
  migrationBatchId String

  rowNumber Int
  status    MigrationRowStatus @default(PENDING)

  category MemberCategory?

  firstName String?
  lastName  String?

  registrationNumber String?
  nationalId         String?
  staffNumber        String?

  yearOfStudy    Int?
  graduationYear Int?
  programme      String?
  faculty        String?
  department     String?
  position       String?

  email   String?
  phone   String?
  address String?
  county  String?

  memberId     String?
  memberNumber String?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  migrationBatch MigrationBatch @relation(fields: [migrationBatchId], references: [id], onDelete: Cascade)

  @@unique([migrationBatchId, rowNumber])
  @@index([migrationBatchId])
  @@index([status])
  @@index([memberId])
}

model Role {
  id             String @id @default(uuid())
  organizationId String

  name         String
  code         String
  description  String?
  isSystemRole Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  assignedAt DateTime @default(now())
  assignedBy String?

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([revokedAt])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id             String  @id @default(uuid())
  organizationId String
  memberId       String?
  userId         String?

  type    NotificationType
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  recipient   String
  subject     String?
  templateKey String?

  providerMessageId String?

  sentAt   DateTime?
  failedAt DateTime?

  errorMessage String?
  attempts     Int     @default(0)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([memberId])
  @@index([userId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}
